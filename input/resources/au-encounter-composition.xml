      <type>
        <code value="Reference"/>
        <targetProfile value="http://hl7.org/fhir/StructureDefinition/DeviceUseStatement"/>
      </type>
      <mustSupport value="true"/>
    </element>
    <element id="Composition.section:sectionAdvanceDirectives">
      <path value="Composition.section"/>
      <sliceName value="sectionAdvanceDirectives"/>
      <short value="Encounter Record Summary Advance Directives Section"/>
      <definition value="Information about a patient's advance directives."/>
